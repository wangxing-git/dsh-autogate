{
  "name": "dsh-autogate",
  "version": "0.2.1",
  "description": "DeepSeek Harness 自动审批插件：在 workspace-write 沙箱之上增加 Auto 档——确定性规则放行/拒绝，模糊操作由 LLM 裁决，危险操作转人工。保留工作区沙箱边界，不放宽为 full-access。",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "auto",
    "approval",
    "permission",
    "security",
    "plugin"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json && node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-api-remotes": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-connection": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-locale": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-llm": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-permission-presets": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-settings": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-tools": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-user-approval": "^0.1.2-alpha.5",
    "@deepseek-ai/schemastery": "^3.18.2",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-remotes": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-permission-presets": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-user-approval": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-llm": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-permission-presets": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-settings": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-tools": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-user-approval": "^0.1.2-alpha.5",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangxing-git/dsh-autogate.git"
  },
  "homepage": "https://github.com/wangxing-git/dsh-autogate#readme",
  "bugs": {
    "url": "https://github.com/wangxing-git/dsh-autogate/issues"
  },
  "author": "wangxing",
  "license": "MIT"
}
